generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IngredientUnit {
  mg
  g
  tsp
  tbsp
  c
  pc
}

/// shared/modules/recipes.ts `Recipe`.
model Recipe {
  id          String          @id @default(uuid(7))
  name        String          @db.VarChar(60)
  category    String
  quantity    Int?
  /// Free text, e.g. "2 hr 30 min".
  time        String?
  /// shared/modules/recipes.ts `Temperature`: { unit: "°C" | "°F", value: number }.
  temperature Json?
  description String?
  note        String?
  sections    RecipeSection[]
  steps       RecipeStep[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([category])
  @@map("recipes")
}

/// An ingredient group such as "Dough". A null `name` is a plain list with no heading.
model RecipeSection {
  id          String             @id @default(uuid(7))
  recipeId    String
  recipe      Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position    Int
  name        String?
  ingredients RecipeIngredient[]

  @@unique([recipeId, position])
  @@map("recipe_sections")
}

/// shared/modules/recipes.ts `Ingredient`.
model RecipeIngredient {
  id              String         @id @default(uuid(7))
  sectionId       String
  section         RecipeSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position        Int
  quantity        Float
  unit            IngredientUnit @default(g)
  ingredient_name String

  @@unique([sectionId, position])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id       String          @id @default(uuid(7))
  recipeId String
  recipe   Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position Int
  text     String
  tags     RecipeStepTag[]

  @@unique([recipeId, position])
  @@map("recipe_steps")
}

/// shared/modules/recipes.ts `StepTag`.
model RecipeStepTag {
  id          String     @id @default(uuid(7))
  stepId      String
  step        RecipeStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  position    Int
  description String?

  @@unique([stepId, position])
  @@map("recipe_step_tags")
}

model SalesEntry {
  id        String      @id @default(uuid(7))
  date      DateTime    @db.Timestamp(0)
  title     String      @db.VarChar(60)
  items     SalesItem[]
  note      String      @default("")
  /// Set when the entry was made by completing a pre-order.
  preOrder  PreOrder?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@index([date])
  @@map("sales_entries")
}

model SalesItem {
  id           String     @id @default(uuid(7))
  salesEntryId String
  salesEntry   SalesEntry @relation(fields: [salesEntryId], references: [id], onDelete: Cascade)
  position     Int
  productName  String
  price        Decimal    @db.Decimal(10, 2)
  quantity     Int

  @@unique([salesEntryId, position])
  @@index([productName])
  @@map("sales_items")
}

/// shared/modules/auth.ts `AuthUser`. Rows are inserted directly in the database; `passwordHash` is a bcrypt hash.
model User {
  id           String   @id @default(uuid(7))
  username     String   @unique @db.VarChar(60)
  passwordHash String
  /// Bumped by "sign out everywhere"; tokens signed with an older value stop working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
}

/// shared/modules/category.ts `Category`.
model Category {
  id        String    @id @default(uuid(7))
  name      String    @unique @db.VarChar(60)
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@map("categories")
}

/// shared/modules/product.ts `Product`. `price` and `discountPrice` are PHP.
model Product {
  id               String           @id @default(uuid(7))
  name             String           @db.VarChar(60)
  categoryId       String
  /// A category with products can't be deleted.
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescription String           @db.VarChar(120)
  description      String?
  /// Cloudinary URL.
  imageUrl         String?
  price            Decimal          @db.Decimal(10, 2)
  discountPrice    Decimal?         @db.Decimal(10, 2)
  /// Last sale day (Manila), a calendar date.
  discountEndsAt   DateTime?        @db.Date
  isAvailable      Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  sortOrder        Int              @default(0)
  isArchived       Boolean          @default(false)
  /// Sizes in menu order; none = no sizes. Price, discount and availability are then worked out from them.
  variants         ProductVariant[]
  preOrderItems    PreOrderItem[]
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@map("products")
}

/// A size of a product (Small, Medium, Large, ...). Replaced as a whole when the product is saved.
model ProductVariant {
  id            String   @id @default(uuid(7))
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position      Int
  name          String   @db.VarChar(30)
  price         Decimal  @db.Decimal(10, 2)
  /// Amount off, until the product's discountEndsAt.
  discountPrice Decimal? @db.Decimal(10, 2)
  isAvailable   Boolean  @default(true)

  @@unique([productId, position])
  @@map("product_variants")
}

/// shared/modules/menu.ts `BusinessSettings`. A single row with the id "singleton".
model BusinessSettings {
  id                  String   @id @default("singleton")
  businessName        String   @db.VarChar(60)
  tagline             String
  contactNumber       String
  heroImageUrl        String?
  /// Whether /menu takes pre-orders.
  preOrdersOpen       Boolean  @default(true)
  /// Hand-over weekdays, 1 (Monday) to 5 (Friday).
  preOrderDays        Int[]    @default([4])
  /// Orders close at the end of the day this many days before the hand-over day.
  preOrderCutoffDays  Int      @default(1)
  /// Closing time on the cut-off day, Manila, HH:mm.
  preOrderCutoffTime  String   @default("23:59") @db.VarChar(5)
  preOrderHandoffTime String   @default("") @db.VarChar(80)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  @@map("business_settings")
}

enum PreOrderStatus {
  pending
  confirmed
  completed
  cancelled
}

/// shared/modules/pre-order.ts `PreOrder`.
model PreOrder {
  id            String         @id @default(uuid(7))
  code          String         @unique @db.VarChar(8)
  customerName  String         @db.VarChar(60)
  email         String         @db.VarChar(254)
  contactNumber String         @db.VarChar(20)
  /// Grade & section on older orders; no longer asked, "" since.
  handoff       String         @default("") @db.VarChar(80)
  /// Hand-over day (Manila), a calendar date.
  pickupDate    DateTime       @db.Date
  note          String         @default("")
  status        PreOrderStatus @default(pending)
  cancelReason  String?
  items         PreOrderItem[]
  salesEntryId  String?        @unique
  salesEntry    SalesEntry?    @relation(fields: [salesEntryId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@index([pickupDate])
  @@map("pre_orders")
}

/// shared/modules/pre-order.ts `PreOrderItem`. Name and price are copied from the product when ordered.
model PreOrderItem {
  id          String   @id @default(uuid(7))
  preOrderId  String
  preOrder    PreOrder @relation(fields: [preOrderId], references: [id], onDelete: Cascade)
  position    Int
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int

  @@unique([preOrderId, position])
  @@index([productId])
  @@map("pre_order_items")
}
